// Control Variables
volatile float target_freq = 25.0f;  // Setpoint frequency in Hz (e.g., 25 Hz)
volatile float current_freq = 0.0f;   // Actual frequency executing
volatile float angle_rad = 0.0f;      // Current electrical angle
extern TIM_HandleTypeDef htim1;       // Advanced Timer handle

// Fast Sine Look-up Helper
float Get_Sine(float angle) {
    while (angle >= 2.0f * PI) angle -= 2.0f * PI;
    while (angle < 0.0f) angle += 2.0f * PI;
    int index = (int)((angle / (2.0f * PI)) * SINE_STEPS);
    return sine_table[index % SINE_STEPS];
}

// 10 kHz TIM1 Update Interrupt - Executes Scalar V/f Logic
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM1) {
        
        // 1. Soft-Start Frequency Ramp (Prevents Inrush Current)
        float ramp_step = 0.05f; // 5 Hz/sec acceleration
        if (current_freq < target_freq) {
            current_freq += ramp_step;
            if (current_freq > target_freq) current_freq = target_freq;
        } else if (current_freq > target_freq) {
            current_freq -= ramp_step;
            if (current_freq < target_freq) current_freq = target_freq;
        }

        // 2. Linear V/f Profile Calculation with Voltage Boost
        float modulation_index = 0.0f;
        if (current_freq > 0.5f) {
            // V/f equation: M = V_boost + (1 - V_boost) * (f / f_rated)
            modulation_index = V_BOOST + (1.0f - V_BOOST) * (current_freq / BASE_FREQ);
            if (modulation_index > 1.0f) modulation_index = 1.0f; // Limit to 100% modulation
        } else {
            modulation_index = 0.0f; // Stop output below 0.5 Hz
        }

        // 3. Electrical Angle Integration
        angle_rad += 2.0f * PI * current_freq * TS;
        if (angle_rad >= 2.0f * PI) {
            angle_rad -= 2.0f * PI;
        }

        // 4. Three-Phase Sine Wave Generation (120° Phase Shifts)
        float sin_u = Get_Sine(angle_rad);
        float sin_v = Get_Sine(angle_rad - (2.0f * PI / 3.0f));
        float sin_w = Get_Sine(angle_rad + (2.0f * PI / 3.0f));

        // 5. Convert -1.0 to +1.0 Sine Waves to Duty Cycle Registers
        uint32_t ccr1 = (uint32_t)(((sin_u * modulation_index) + 1.0f) * 0.5f * PWM_ARR);
        uint32_t ccr2 = (uint32_t)(((sin_v * modulation_index) + 1.0f) * 0.5f * PWM_ARR);
        uint32_t ccr3 = (uint32_t)(((sin_w * modulation_index) + 1.0f) * 0.5f * PWM_ARR);

        // 6. Update PWM Registers (Hardware Compare Units)
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, ccr1);
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, ccr2);
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, ccr3);
    }
}

// System Initialization Call
void Start_Motor_Inverter(void) {
    // Start Complementary PWM Channels for IPM Drive
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_2);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);
    HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_3);

    // Enable Timer Interrupt for Real-Time Execution
    HAL_TIM_Base_Start_IT(&htim1);
}
